# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Primary backend: Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Fallback backend: Cloudflare Workers AI ---
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# --- Backend selector (gemini | local | cloudflare) ---
# BACKEND=gemini         # Gemini API (default, requires GEMINI_API_KEY)
# BACKEND=local          # faster-whisper on CPU, no internet required
# BACKEND=cloudflare     # Cloudflare Workers AI (requires CLOUDFLARE_* keys)
BACKEND=gemini

# --- Gemini model ---
GEMINI_MODEL=gemini-2.0-flash

# --- Local Whisper model (used when BACKEND=local) ---
# Sizes: tiny | base | small | medium | large-v3
# base: ~150MB, good balance of speed and accuracy for Japanese
WHISPER_MODEL=base

# --- Custom dictionary ---
# Words listed here (one per line, # for comments) are injected as preferred vocabulary.
# Priority: DICTIONARY_FILE > ./dictionary.txt > %APPDATA%/voice-fep/dictionary.txt
# DICTIONARY_FILE=C:\Users\you\dictionary.txt

# --- Recording time safety limit (seconds) ---
# Auto-stops recording if F8 is held longer than this value.
RECORD_MAX_SEC=30

# --- Hotkeys ---
# Record (push-to-talk): ctrl+space by default
HOTKEY=ctrl+space
# Quick dict add (from clipboard): shift+space by default
DICT_HOTKEY=shift+space

# --- Logging ---
# ENABLE_LOG_FILE=true    # true (default) writes voice-fep.log; false = console only
# LOG_LEVEL=INFO          # INFO (default) | DEBUG | WARNING | ERROR
